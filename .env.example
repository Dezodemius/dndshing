APP_ENV=local

# Основная БД (совпадает с docker-compose.yml по умолчанию)
DATABASE_URL=postgresql+asyncpg://dndshing:dndshing@localhost:5432/dndshing

# Тестовая БД (создаётся docker/postgres/init-test-db.sh при первом старте контейнера)
TEST_DATABASE_URL=postgresql+asyncpg://dndshing:dndshing@localhost:5432/dndshing_test

# Задел фазы 2 (BR §6): AI-эндпоинт, OpenAI-совместимый. Не используется в MVP.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
