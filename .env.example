# Шаблон локального конфига. Секретов в репозитории нет и быть не должно:
# пустые значения ниже заполняются руками, дефолтов у них нет ни здесь, ни в коде.
#
# Сгенерировать пароль:  python -c "import secrets; print(secrets.token_urlsafe(24))"

APP_ENV=local

# Креды postgres из docker-compose.yml. Пока POSTGRES_PASSWORD пуст,
# `docker compose up` откажется стартовать — это ожидаемо.
POSTGRES_USER=dndshing
POSTGRES_PASSWORD=
POSTGRES_DB=dndshing

# Порт БД на хосте. Если 5432 уже занят другим постгресом — поменяй здесь
# и в обоих URL ниже (внутри compose-сети api всё равно ходит на db:5432).
POSTGRES_HOST_PORT=5432

# Порт фронта на хосте: там же, на http://localhost:8080, отвечает и API через
# /api/v1 — nginx из контейнера frontend проксирует его на api. Не 5173, чтобы
# порт оставался свободен для `npm run dev` с хоста.
FRONTEND_HOST_PORT=8080

# Тот же пароль подставить в обе строки ниже, между двоеточием и собакой.
# Хост здесь localhost, а не db: так ходят alembic и pytest с хоста, вне контейнера.
DATABASE_URL=postgresql+asyncpg://dndshing:@localhost:5432/dndshing

# Тестовая БД (создаётся docker/postgres/init-test-db.sh при первом старте контейнера)
TEST_DATABASE_URL=postgresql+asyncpg://dndshing:@localhost:5432/dndshing_test

# Секрет для подписи JWT. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Задел фазы 2 (BR §6): AI-эндпоинт, OpenAI-совместимый. Не используется в MVP.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Куда ведёт редирект после OAuth-логина. Дефолта нет: дефолт вроде
# localhost:5173 пропустил бы забытую настройку и молча редиректил
# реальных пользователей на дев-адрес (правило 12).
FRONTEND_BASE_URL=

# OAuth: Яндекс. Все три пустые = провайдер выключен (authorize/callback
# отвечают 404), без падения старта — в отличие от JWT_SECRET_KEY выше это не
# обязательный для работы платформы секрет. Завести приложение:
# https://oauth.yandex.ru/. YANDEX_REDIRECT_URI — точный callback-URL,
# зарегистрированный в приложении (белый список, не строится из запроса).
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=

# OAuth: VK ID. Та же логика, что у Яндекса выше — все три пустые = выключено.
# Завести приложение: https://id.vk.com/business/go/docs/vkid/latest/start-integration/create-application
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=

# OAuth: Mail.ru. Тот же принцип, что и у Яндекса выше. Завести приложение:
# https://o2.mail.ru/app/. MAILRU_REDIRECT_URI — точный callback-URL,
# зарегистрированный в приложении (белый список, не строится из запроса).
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=
MAILRU_REDIRECT_URI=

# Отдельная браузерная админка импорта контент-паков (/internal/admin/content-import),
# логин по HTTP Basic парой ниже — не через User/is_admin. Та же логика, что у OAuth
# выше: обе пустые = панель выключена (роуты отвечают 404).
ADMIN_PANEL_USERNAME=
ADMIN_PANEL_PASSWORD=
